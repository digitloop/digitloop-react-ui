{
  "name": "digitloop-react-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./components": {
      "default": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./utils": {
      "default": "./dist/lib/utils.d.ts",
      "types": "./dist/lib/utils.js"
    },
    "./dist/nprogress.css": "./dist/nprogress.css"
